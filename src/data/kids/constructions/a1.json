g"],"tiles":["on","book"],"noteFr":"« In » veut dire dans."},{"id":"kcon-a1-u03-02","level":"A1","unit":3,"unitTitleFr":"Ma journée et mes affaires","order":2,"promptFr":"Le livre est sur le bureau","answers":["The book is on the desk"],"tiles":["under","chair"],"noteFr":"« On » veut dire sur."},{"id":"kcon-a1-u03-03","level":"A1","unit":3,"unitTitleFr":"Ma journée et mes affaires","order":3,"promptFr":"Le chat dort sous la chaise","answers":["The cat sleeps under the chair"],"tiles":["on","dog"],"noteFr":"« Under » veut dire sous."},{"id":"kcon-a1-u03-04","level":"A1","unit":3,"unitTitleFr":"Ma journée et mes affaires","order":4,"promptFr":"Je me réveille tôt","answers":["I wake up early"],"tiles":["sleep","late"],"noteFr":"« Wake up » = se réveiller."},{"id":"kcon-a1-u03-05","level":"A1","unit":3,"unitTitleFr":"Ma journée et mes affaires","order":5,"promptFr":"Mets tes chaussures","answers":["Put on your shoes"],"tiles":["shirt","take"],"noteFr":"« Put on » = enfiler / mettre."},{"id":"kcon-a1-u03-06","level":"A1","unit":3,"unitTitleFr":"Ma journée et mes affaires","order":6,"promptFr":"Il y a dix élèves","answers":["There are ten pupils"],"tiles":["is","five"],"noteFr":"« There are » pour plusieurs personnes."},{"id":"kcon-a1-u03-07","level":"A1","unit":3,"unitTitleFr":"Ma journée et mes affaires","order":7,"promptFr":"Il fait beau aujourd'hui","answers":["Today is sunny"],"tiles":["rainy","yesterday"],"noteFr":"« Sunny » = ensoleillé."},{"id":"kcon-a1-u03-08","level":"A1","unit":3,"unitTitleFr":"Ma journée et mes affaires","order":8,"promptFr":"Écoute l'histoire","answers":["Listen to the story"],"tiles":["read","book"],"noteFr":"On dit toujours « listen to »."}]