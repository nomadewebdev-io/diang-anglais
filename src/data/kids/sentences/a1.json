[{"id":"ksent-a1-01","level":"A1","en":"The elephant is very big.","fr":"L'éléphant est très grand."},{"id":"ksent-a1-02","level":"A1","en":"The monkey climbs tall trees.","fr":"Le singe grimpe aux grands arbres."},{"id":"ksent-a1-03","level":"A1","en":"The zebra has black stripes.","fr":"Le zèbre a des rayures noires."},{"id":"ksent-a1-04","level":"A1","en":"The turtle walks very slowly.","fr":"La tortue marche très lentement."},{"id":"ksent-a1-05","level":"A1","en":"Her drawing is very colorful.","fr":"Son dessin est très coloré."},{"id":"ksent-a1-06","level":"A1","en":"I have striped blue socks.","fr":"J'ai des chaussettes bleues rayées."},{"id":"ksent-a1-07","level":"A1","en":"Twelve months make one year.","fr":"Douze mois font une année."},{"id":"ksent-a1-08","level":"A1","en":"Twenty pupils sit in class.","fr":"Vingt élèves sont assis en classe."},{"id":"ksent-a1-09","level":"A1","en":"Grandma bakes sweet bread today.","fr":"Mamie prépare du pain sucré aujourd'hui."},{"id":"ksent-a1-10","level":"A1","en":"My cousin lives near school.","fr":"Mon cousin habite près de l'école."},{"id":"ksent-a1-11","level":"A1","en":"My parents help me daily.","fr":"Mes parents m'aident chaque jour."},{"id":"ksent-a1-12","level":"A1","en":"Happy birthday to my friend!","fr":"Joyeux anniversaire à mon ami !"},{"id":"ksent-a1-13","level":"A1","en":"Brush your clean white teeth.","fr":"Brosse tes dents blanches et propres."},{"id":"ksent-a1-14","level":"A1","en":"Giraffes have very long necks.","fr":"Les girafes ont de très longs cous."},{"id":"ksent-a1-15","level":"A1","en":"Give a big friendly smile.","fr":"Fais un grand sourire amical."},{"id":"ksent-a1-16","level":"A1","en":"Our teacher explains the lesson.","fr":"Notre maîtresse explique la leçon."},{"id":"ksent-a1-17","level":"A1","en":"Write neatly in your notebook.","fr":"Écris proprement dans ton cahier."},{"id":"ksent-a1-18","level":"A1","en":"We play games during recess.","fr":"Nous jouons pendant la récréation."},{"id":"ksent-a1-19","level":"A1","en":"Crunchy orange carrots taste good.","fr":"Les carottes croquantes sont bonnes."},{"id":"ksent-a1-20","level":"A1","en":"Spread sweet butter on bread.","fr":"Étale du beurre sur le pain."},{"id":"ksent-a1-21","level":"A1","en":"Eat hot vegetable soup now.","fr":"Mange de la soupe chaude maintenant."},{"id":"ksent-a1-22","level":"A1","en":"Zip up your warm jacket.","fr":"Ferme ta veste chaude."},{"id":"ksent-a1-23","level":"A1","en":"Wear yellow shorts in summer.","fr":"Mets un short jaune en été."},{"id":"ksent-a1-24","level":"A1","en":"Wrap a cozy red scarf.","fr":"Enroule une écharpe rouge douillette."},{"id":"ksent-a1-25","level":"A1","en":"Today is warm and sunny.","fr":"Aujourd'hui il fait chaud et beau."},{"id":"ksent-a1-26","level":"A1","en":"Stay inside on rainy days.","fr":"Reste dedans les jours de pluie."},{"id":"ksent-a1-27","level":"A1","en":"Water the pink garden flower.","fr":"Arrose la fleur rose du jardin."},{"id":"ksent-a1-28","level":"A1","en":"My bedroom is neat and quiet.","fr":"Ma chambre est rangée et calme."},{"id":"ksent-a1-29","level":"A1","en":"Mom cooks in the kitchen.","fr":"Maman cuisine dans la cuisine."},{"id":"ksent-a1-30","level":"A1","en":"Sit on the soft sofa.","fr":"Assieds-toi sur le canapé doux."},{"id":"ksent-a1-31","level":"A1","en":"I wake up at seven.","fr":"Je me réveille à sept heures."},{"id":"ksent-a1-32","level":"A1","en":"Wash your hands with soap.","fr":"Lave-toi les mains au savon."},{"id":"ksent-a1-33","level":"A1","en":"Lunch is ready at noon.","fr":"Le déjeuner est prêt à midi."},{"id":"ksent-a1-34","level":"A1","en":"Listen carefully to the story.","fr":"Écoute attentivement l'histoire."},{"id":"ksent-a1-35","level":"A1","en":"Draw a happy little cat.","fr":"Dessine un petit chat joyeux."},{"id":"ksent-a1-36","level":"A1","en":"Count all the bright stars.","fr":"Compte toutes les étoiles brillantes."},{"id":"ksent-a1-37","level":"A1","en":"Ducks swim in the pond.","fr":"Les canards nagent dans l'étang."},{"id":"ksent-a1-38","level":"A1","en":"Share your snacks with friends.","fr":"Partage ton goûter avec tes amis."},{"id":"ksent-a1-39","level":"A1","en":"Good morning, my dear friend!","fr":"Bonjour, mon cher ami !"},{"id":"ksent-a1-40","level":"A1","en":"We dance to happy music.","fr":"Nous dansons sur une musique joyeuse."}]