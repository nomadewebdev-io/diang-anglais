[{"id":"ksent-a0-01","level":"A0","en":"Hello! My name is Awa.","fr":"Bonjour ! Je m'appelle Awa."},{"id":"ksent-a0-02","level":"A0","en":"The cat sleeps.","fr":"Le chat dort."},{"id":"ksent-a0-03","level":"A0","en":"My dog runs fast.","fr":"Mon chien court vite."},{"id":"ksent-a0-04","level":"A0","en":"A blue bird sings.","fr":"Un oiseau bleu chante."},{"id":"ksent-a0-05","level":"A0","en":"I have a red ball.","fr":"J'ai un ballon rouge."},{"id":"ksent-a0-06","level":"A0","en":"The sky is blue.","fr":"Le ciel est bleu."},{"id":"ksent-a0-07","level":"A0","en":"The sun is yellow.","fr":"Le soleil est jaune."},{"id":"ksent-a0-08","level":"A0","en":"Open your book now.","fr":"Ouvre ton livre maintenant."},{"id":"ksent-a0-09","level":"A0","en":"I see one bird.","fr":"Je vois un oiseau."},{"id":"ksent-a0-10","level":"A0","en":"I have two hands.","fr":"J'ai deux mains."},{"id":"ksent-a0-11","level":"A0","en":"Three cats sleep here.","fr":"Trois chats dorment ici."},{"id":"ksent-a0-12","level":"A0","en":"My mother smiles warmly.","fr":"Ma maman sourit chaleureusement."},{"id":"ksent-a0-13","level":"A0","en":"My father reads books.","fr":"Mon papa lit des livres."},{"id":"ksent-a0-14","level":"A0","en":"Wash your hands first.","fr":"Lave tes mains d'abord."},{"id":"ksent-a0-15","level":"A0","en":"I eat an apple.","fr":"Je mange une pomme."},{"id":"ksent-a0-16","level":"A0","en":"This mango is sweet.","fr":"Cette mangue est sucrée."},{"id":"ksent-a0-17","level":"A0","en":"Drink cold water please.","fr":"Bois de l'eau fraîche s'il te plaît."},{"id":"ksent-a0-18","level":"A0","en":"I drink warm milk.","fr":"Je bois du lait chaud."},{"id":"ksent-a0-19","level":"A0","en":"We cook white rice.","fr":"Nous cuisinons du riz blanc."},{"id":"ksent-a0-20","level":"A0","en":"Wear your sun hat.","fr":"Mets ton chapeau de soleil."},{"id":"ksent-a0-21","level":"A0","en":"My pants are blue.","fr":"Mon pantalon est bleu."},{"id":"ksent-a0-22","level":"A0","en":"She wears a pink dress.","fr":"Elle porte une robe rose."},{"id":"ksent-a0-23","level":"A0","en":"Tie your white shoes.","fr":"Attache tes chaussures blanches."},{"id":"ksent-a0-24","level":"A0","en":"The moon is round.","fr":"La lune est ronde."},{"id":"ksent-a0-25","level":"A0","en":"See the bright star.","fr":"Vois l'étoile brillante."},{"id":"ksent-a0-26","level":"A0","en":"Sit under the tree.","fr":"Assieds-toi sous l'arbre."},{"id":"ksent-a0-27","level":"A0","en":"Our house is clean.","fr":"Notre maison est propre."},{"id":"ksent-a0-28","level":"A0","en":"Close the front door.","fr":"Ferme la porte d'entrée."},{"id":"ksent-a0-29","level":"A0","en":"Make your bed now.","fr":"Fais ton lit maintenant."},{"id":"ksent-a0-30","level":"A0","en":"Turn on the lamp.","fr":"Allume la lampe."},{"id":"ksent-a0-31","level":"A0","en":"Thank you very much!","fr":"Merci beaucoup !"},{"id":"ksent-a0-32","level":"A0","en":"Yes, I am ready.","fr":"Oui, je suis prêt."},{"id":"ksent-a0-33","level":"A0","en":"I sleep at nine.","fr":"Je dors à neuf heures."},{"id":"ksent-a0-34","level":"A0","en":"Let us play outside!","fr":"Jouons dehors !"},{"id":"ksent-a0-35","level":"A0","en":"Run to the tree!","fr":"Cours jusqu'à l'arbre !"},{"id":"ksent-a0-36","level":"A0","en":"I read every evening.","fr":"Je lis chaque soir."},{"id":"ksent-a0-37","level":"A0","en":"Write your name clearly.","fr":"Écris ton prénom clairement."},{"id":"ksent-a0-38","level":"A0","en":"We sing happy songs.","fr":"Nous chantons des chansons joyeuses."},{"id":"ksent-a0-39","level":"A0","en":"The green frog hops.","fr":"La grenouille verte saute."},{"id":"ksent-a0-40","level":"A0","en":"The cow eats grass.","fr":"La vache mange de l'herbe."}]