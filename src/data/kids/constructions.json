[
  { "id": "kcon-a0-u01-01", "level": "A0", "unit": 1, "unitTitleFr": "Animaux et couleurs", "order": 1, "promptFr": "Un chat rouge", "answers": ["A red cat"], "tiles": ["blue", "dog"], "noteFr": "La couleur se place avant l'animal." },
  { "id": "kcon-a0-u01-02", "level": "A0", "unit": 1, "unitTitleFr": "Animaux et couleurs", "order": 2, "promptFr": "Un oiseau bleu", "answers": ["A blue bird"], "tiles": ["red", "cat"], "noteFr": "« Blue » vient juste avant « bird »." },
  { "id": "kcon-a0-u01-03", "level": "A0", "unit": 1, "unitTitleFr": "Animaux et couleurs", "order": 3, "promptFr": "Un chien noir", "answers": ["A black dog"], "tiles": ["white", "fish"], "noteFr": "« Black » avant « dog »." },
  { "id": "kcon-a0-u01-04", "level": "A0", "unit": 1, "unitTitleFr": "Animaux et couleurs", "order": 4, "promptFr": "Une grenouille verte", "answers": ["A green frog"], "tiles": ["yellow", "duck"], "noteFr": "« Green » décrit « frog »." },
  { "id": "kcon-a0-u01-05", "level": "A0", "unit": 1, "unitTitleFr": "Animaux et couleurs", "order": 5, "promptFr": "Un canard jaune", "answers": ["A yellow duck"], "tiles": ["pink", "cow"], "noteFr": "« Yellow » avant « duck »." },
  { "id": "kcon-a0-u01-06", "level": "A0", "unit": 1, "unitTitleFr": "Animaux et couleurs", "order": 6, "promptFr": "Un cheval marron", "answers": ["A brown horse"], "tiles": ["gray", "sheep"], "noteFr": "« Brown » signifie marron." },
  { "id": "kcon-a0-u01-07", "level": "A0", "unit": 1, "unitTitleFr": "Animaux et couleurs", "order": 7, "promptFr": "Un mouton blanc", "answers": ["A white sheep"], "tiles": ["black", "goat"], "noteFr": "« White » signifie blanc." },
  { "id": "kcon-a0-u01-08", "level": "A0", "unit": 1, "unitTitleFr": "Animaux et couleurs", "order": 8, "promptFr": "Un chat gris", "answers": ["A gray cat"], "tiles": ["red", "bird"], "noteFr": "« Gray » veut dire gris." },

  { "id": "kcon-a0-u02-01", "level": "A0", "unit": 2, "unitTitleFr": "Compter et se présenter", "order": 1, "promptFr": "Bonjour, je m'appelle Awa", "answers": ["Hello, my name is Awa", "Hello my name is Awa"], "tiles": ["goodbye", "book"], "noteFr": "« My name is... » sert à te présenter." },
  { "id": "kcon-a0-u02-02", "level": "A0", "unit": 2, "unitTitleFr": "Compter et se présenter", "order": 2, "promptFr": "J'ai un chien", "answers": ["I have a dog"], "tiles": ["cat", "two"], "noteFr": "« I have » veut dire « j'ai »." },
  { "id": "kcon-a0-u02-03", "level": "A0", "unit": 2, "unitTitleFr": "Compter et se présenter", "order": 3, "promptFr": "Je vois deux chats", "answers": ["I see two cats"], "tiles": ["one", "dog"], "noteFr": "Ajoute -s à « cats » quand il y en a deux." },
  { "id": "kcon-a0-u02-04", "level": "A0", "unit": 2, "unitTitleFr": "Compter et se présenter", "order": 4, "promptFr": "J'ai trois livres", "answers": ["I have three books"], "tiles": ["two", "pen"], "noteFr": "« Books » prend un -s." },
  { "id": "kcon-a0-u02-05", "level": "A0", "unit": 2, "unitTitleFr": "Compter et se présenter", "order": 5, "promptFr": "Tu es mon ami", "answers": ["You are my friend"], "tiles": ["am", "sister"], "noteFr": "Avec « you », utilise « are »." },
  { "id": "kcon-a0-u02-06", "level": "A0", "unit": 2, "unitTitleFr": "Compter et se présenter", "order": 6, "promptFr": "Je suis prêt", "answers": ["I am ready"], "tiles": ["are", "tired"], "noteFr": "Avec « I », utilise « am »." },
  { "id": "kcon-a0-u02-07", "level": "A0", "unit": 2, "unitTitleFr": "Compter et se présenter", "order": 7, "promptFr": "Cinq étoiles brillent", "answers": ["Five stars shine"], "tiles": ["ten", "moon"], "noteFr": "« Five » = cinq." },
  { "id": "kcon-a0-u02-08", "level": "A0", "unit": 2, "unitTitleFr": "Compter et se présenter", "order": 8, "promptFr": "Merci beaucoup", "answers": ["Thank you very much"], "tiles": ["please", "hello"], "noteFr": "« Thank you » veut dire merci." },

  { "id": "kcon-a0-u03-01", "level": "A0", "unit": 3, "unitTitleFr": "À l'école et à la maison", "order": 1, "promptFr": "Ouvre ton livre", "answers": ["Open your book"], "tiles": ["close", "pen"], "noteFr": "« Open » signifie ouvre." },
  { "id": "kcon-a0-u03-02", "level": "A0", "unit": 3, "unitTitleFr": "À l'école et à la maison", "order": 2, "promptFr": "Ferme la porte", "answers": ["Close the door"], "tiles": ["open", "window"], "noteFr": "« Close » signifie ferme." },
  { "id": "kcon-a0-u03-03", "level": "A0", "unit": 3, "unitTitleFr": "À l'école et à la maison", "order": 3, "promptFr": "Je mange une pomme", "answers": ["I eat an apple"], "tiles": ["a", "banana"], "noteFr": "Devant « apple », « a » devient « an »." },
  { "id": "kcon-a0-u03-04", "level": "A0", "unit": 3, "unitTitleFr": "À l'école et à la maison", "order": 4, "promptFr": "Je bois de l'eau froide", "answers": ["I drink cold water"], "tiles": ["hot", "milk"], "noteFr": "L'adjectif « cold » vient avant « water »." },
  { "id": "kcon-a0-u03-05", "level": "A0", "unit": 3, "unitTitleFr": "À l'école et à la maison", "order": 5, "promptFr": "Le soleil est jaune", "answers": ["The sun is yellow"], "tiles": ["blue", "moon"], "noteFr": "« Is » relie le soleil à sa couleur." },
  { "id": "kcon-a0-u03-06", "level": "A0", "unit": 3, "unitTitleFr": "À l'école et à la maison", "order": 6, "promptFr": "Allume la lampe", "answers": ["Turn on the lamp"], "tiles": ["key", "bed"], "noteFr": "« Turn on » veut dire allume." },
  { "id": "kcon-a0-u03-07", "level": "A0", "unit": 3, "unitTitleFr": "À l'école et à la maison", "order": 7, "promptFr": "Fais ton lit", "answers": ["Make your bed"], "tiles": ["chair", "table"], "noteFr": "On dit « make your bed » pour faire son lit." },
  { "id": "kcon-a0-u03-08", "level": "A0", "unit": 3, "unitTitleFr": "À l'école et à la maison", "order": 8, "promptFr": "Lave tes mains", "answers": ["Wash your hands"], "tiles": ["foot", "head"], "noteFr": "« Wash » signifie lave." },

  { "id": "kcon-a1-u01-01", "level": "A1", "unit": 1, "unitTitleFr": "Dire ce que j'aime", "order": 1, "promptFr": "J'aime les bananes", "answers": ["I like bananas"], "tiles": ["don't", "apple"], "noteFr": "Utilise « I like » avec le fruit au pluriel." },
  { "id": "kcon-a1-u01-02", "level": "A1", "unit": 1, "unitTitleFr": "Dire ce que j'aime", "order": 2, "promptFr": "Je n'aime pas la pluie", "answers": ["I don't like rain", "I do not like rain"], "tiles": ["sun", "is"], "noteFr": "« Don't like » sert à dire que tu n'aimes pas." },
  { "id": "kcon-a1-u01-03", "level": "A1", "unit": 1, "unitTitleFr": "Dire ce que j'aime", "order": 3, "promptFr": "Aimes-tu les chats ?", "answers": ["Do you like cats?", "Do you like cats"], "tiles": ["are", "dogs"], "noteFr": "Commence la question par « Do you like... »." },
  { "id": "kcon-a1-u01-04", "level": "A1", "unit": 1, "unitTitleFr": "Dire ce que j'aime", "order": 4, "promptFr": "Ma sœur aime les mangues", "answers": ["My sister likes mangoes"], "tiles": ["like", "brother"], "noteFr": "Avec « my sister », « like » prend un -s." },
  { "id": "kcon-a1-u01-05", "level": "A1", "unit": 1, "unitTitleFr": "Dire ce que j'aime", "order": 5, "promptFr": "Les souris aiment le fromage", "answers": ["Mice like cheese"], "tiles": ["cats", "bread"], "noteFr": "« Mice » est le pluriel de « mouse »." },
  { "id": "kcon-a1-u01-06", "level": "A1", "unit": 1, "unitTitleFr": "Dire ce que j'aime", "order": 6, "promptFr": "J'aime le jus d'orange", "answers": ["I like orange juice"], "tiles": ["milk", "water"], "noteFr": "« Orange juice » = jus d'orange." },
  { "id": "kcon-a1-u01-07", "level": "A1", "unit": 1, "unitTitleFr": "Dire ce que j'aime", "order": 7, "promptFr": "Nous aimons notre école", "answers": ["We like our school"], "tiles": ["house", "they"], "noteFr": "« Our » signifie notre." },
  { "id": "kcon-a1-u01-08", "level": "A1", "unit": 1, "unitTitleFr": "Dire ce que j'aime", "order": 8, "promptFr": "Il aime le vert clair", "answers": ["He likes light green"], "tiles": ["dark", "she"], "noteFr": "« Light green » = vert clair." },

  { "id": "kcon-a1-u02-01", "level": "A1", "unit": 2, "unitTitleFr": "Ce que je sais faire (can)", "order": 1, "promptFr": "Je sais nager", "answers": ["I can swim"], "tiles": ["can't", "run"], "noteFr": "« I can » veut dire je sais / je peux." },
  { "id": "kcon-a1-u02-02", "level": "A1", "unit": 2, "unitTitleFr": "Ce que je sais faire (can)", "order": 2, "promptFr": "Les oiseaux savent voler", "answers": ["Birds can fly"], "tiles": ["swim", "dogs"], "noteFr": "« Fly » signifie voler." },
  { "id": "kcon-a1-u02-03", "level": "A1", "unit": 2, "unitTitleFr": "Ce que je sais faire (can)", "order": 3, "promptFr": "Les tortues ne savent pas voler", "answers": ["Turtles can't fly", "Turtles cannot fly"], "tiles": ["can", "walk"], "noteFr": "« Can't » indique l'impossibilité." },
  { "id": "kcon-a1-u02-04", "level": "A1", "unit": 2, "unitTitleFr": "Ce que je sais faire (can)", "order": 4, "promptFr": "Sais-tu dessiner ?", "answers": ["Can you draw?", "Can you draw"], "tiles": ["do", "sing"], "noteFr": "Inverse « Can » et « you » pour poser la question." },
  { "id": "kcon-a1-u02-05", "level": "A1", "unit": 2, "unitTitleFr": "Ce que je sais faire (can)", "order": 5, "promptFr": "Elle sait bien chanter", "answers": ["She can sing well"], "tiles": ["he", "dance"], "noteFr": "« Well » se met à la fin." },
  { "id": "kcon-a1-u02-06", "level": "A1", "unit": 2, "unitTitleFr": "Ce que je sais faire (can)", "order": 6, "promptFr": "Nous savons compter jusqu'à vingt", "answers": ["We can count to twenty"], "tiles": ["ten", "read"], "noteFr": "« Count to twenty » = compter jusqu'à vingt." },
  { "id": "kcon-a1-u02-07", "level": "A1", "unit": 2, "unitTitleFr": "Ce que je sais faire (can)", "order": 7, "promptFr": "Peux-tu m'aider ?", "answers": ["Can you help me?", "Can you help me"], "tiles": ["share", "I"], "noteFr": "« Help me » = m'aider." },
  { "id": "kcon-a1-u02-08", "level": "A1", "unit": 2, "unitTitleFr": "Ce que je sais faire (can)", "order": 8, "promptFr": "Il sait sauter haut", "answers": ["He can jump high"], "tiles": ["run", "low"], "noteFr": "« Jump high » = sauter haut." },

  { "id": "kcon-a1-u03-01", "level": "A1", "unit": 3, "unitTitleFr": "Ma journée et mes affaires", "order": 1, "promptFr": "Le stylo est dans le sac", "answers": ["The pen is in the bag"], "tiles": ["on", "book"], "noteFr": "« In » veut dire dans." },
  { "id": "kcon-a1-u03-02", "level": "A1", "unit": 3, "unitTitleFr": "Ma journée et mes affaires", "order": 2, "promptFr": "Le livre est sur le bureau", "answers": ["The book is on the desk"], "tiles": ["under", "chair"], "noteFr": "« On » veut dire sur." },
  { "id": "kcon-a1-u03-03", "level": "A1", "unit": 3, "unitTitleFr": "Ma journée et mes affaires", "order": 3, "promptFr": "Le chat dort sous la chaise", "answers": ["The cat sleeps under the chair"], "tiles": ["on", "dog"], "noteFr": "« Under » veut dire sous." },
  { "id": "kcon-a1-u03-04", "level": "A1", "unit": 3, "unitTitleFr": "Ma journée et mes affaires", "order": 4, "promptFr": "Je me réveille tôt", "answers": ["I wake up early"], "tiles": ["sleep", "late"], "noteFr": "« Wake up » = se réveiller." },
  { "id": "kcon-a1-u03-05", "level": "A1", "unit": 3, "unitTitleFr": "Ma journée et mes affaires", "order": 5, "promptFr": "Mets tes chaussures", "answers": ["Put on your shoes"], "tiles": ["shirt", "take"], "noteFr": "« Put on » = enfiler / mettre." },
  { "id": "kcon-a1-u03-06", "level": "A1", "unit": 3, "unitTitleFr": "Ma journée et mes affaires", "order": 6, "promptFr": "Il y a dix élèves", "answers": ["There are ten pupils"], "tiles": ["is", "five"], "noteFr": "« There are » pour plusieurs personnes." },
  { "id": "kcon-a1-u03-07", "level": "A1", "unit": 3, "unitTitleFr": "Ma journée et mes affaires", "order": 7, "promptFr": "Il fait beau aujourd'hui", "answers": ["Today is sunny"], "tiles": ["rainy", "yesterday"], "noteFr": "« Sunny » = ensoleillé." },
  { "id": "kcon-a1-u03-08", "level": "A1", "unit": 3, "unitTitleFr": "Ma journée et mes affaires", "order": 8, "promptFr": "Écoute l'histoire", "answers": ["Listen to the story"], "tiles": ["read", "book"], "noteFr": "On dit toujours « listen to »." },

  { "id": "kcon-a2-u01-01", "level": "A2", "unit": 1, "unitTitleFr": "Routines et habitudes", "order": 1, "promptFr": "Je me brosse toujours les dents", "answers": ["I always brush my teeth"], "tiles": ["never", "wash"], "noteFr": "« Always » se place avant le verbe." },
  { "id": "kcon-a2-u01-02", "level": "A2", "unit": 1, "unitTitleFr": "Routines et habitudes", "order": 2, "promptFr": "Je finis mes devoirs avant le dîner", "answers": ["I finish my homework before dinner"], "tiles": ["after", "lunch"], "noteFr": "« Before » signifie avant." },
  { "id": "kcon-a2-u01-03", "level": "A2", "unit": 1, "unitTitleFr": "Routines et habitudes", "order": 3, "promptFr": "Nous faisons parfois du vélo", "answers": ["We sometimes ride bikes", "Sometimes we ride bikes"], "tiles": ["always", "swim"], "noteFr": "« Sometimes » = parfois." },
  { "id": "kcon-a2-u01-04", "level": "A2", "unit": 1, "unitTitleFr": "Routines et habitudes", "order": 4, "promptFr": "Elle a un sac à dos violet", "answers": ["She has a purple backpack"], "tiles": ["have", "red"], "noteFr": "Avec « she », « have » devient « has »." },
  { "id": "kcon-a2-u01-05", "level": "A2", "unit": 1, "unitTitleFr": "Routines et habitudes", "order": 5, "promptFr": "Prends une douche rapide", "answers": ["Take a quick shower"], "tiles": ["slow", "bath"], "noteFr": "« Take a shower » = prendre une douche." },
  { "id": "kcon-a2-u01-06", "level": "A2", "unit": 1, "unitTitleFr": "Routines et habitudes", "order": 6, "promptFr": "Range tous tes jouets", "answers": ["Tidy up all your toys"], "tiles": ["clean", "my"], "noteFr": "« Tidy up » = ranger." },
  { "id": "kcon-a2-u01-07", "level": "A2", "unit": 1, "unitTitleFr": "Routines et habitudes", "order": 7, "promptFr": "N'oublie jamais ton sourire", "answers": ["Never forget your smile"], "tiles": ["always", "cry"], "noteFr": "« Never » = jamais." },
  { "id": "kcon-a2-u01-08", "level": "A2", "unit": 1, "unitTitleFr": "Routines et habitudes", "order": 8, "promptFr": "À demain matin !", "answers": ["See you tomorrow morning!", "See you tomorrow morning"], "tiles": ["yesterday", "evening"], "noteFr": "« Tomorrow morning » = demain matin." },

  { "id": "kcon-a2-u02-01", "level": "A2", "unit": 2, "unitTitleFr": "Hier, aujourd'hui et comparaisons", "order": 1, "promptFr": "Hier j'ai nettoyé ma chambre", "answers": ["Yesterday I cleaned my room"], "tiles": ["clean", "tomorrow"], "noteFr": "Ajoute -ed pour parler d'hier." },
  { "id": "kcon-a2-u02-02", "level": "A2", "unit": 2, "unitTitleFr": "Hier, aujourd'hui et comparaisons", "order": 2, "promptFr": "Notre équipe a gagné aujourd'hui", "answers": ["Our team won today"], "tiles": ["lost", "yesterday"], "noteFr": "« Won » est le passé de « win »." },
  { "id": "kcon-a2-u02-03", "level": "A2", "unit": 2, "unitTitleFr": "Hier, aujourd'hui et comparaisons", "order": 3, "promptFr": "Un éléphant est plus grand qu'un chat", "answers": ["An elephant is bigger than a cat"], "tiles": ["smaller", "dog"], "noteFr": "Ajoute -er et « than » pour comparer." },
  { "id": "kcon-a2-u02-04", "level": "A2", "unit": 2, "unitTitleFr": "Hier, aujourd'hui et comparaisons", "order": 4, "promptFr": "Où est ton sac à dos ?", "answers": ["Where is your backpack?", "Where is your backpack"], "tiles": ["when", "what"], "noteFr": "« Where » signifie où." },
  { "id": "kcon-a2-u02-05", "level": "A2", "unit": 2, "unitTitleFr": "Hier, aujourd'hui et comparaisons", "order": 5, "promptFr": "Regarde l'arc-en-ciel dans le ciel", "answers": ["Look at the rainbow in the sky"], "tiles": ["rain", "on"], "noteFr": "On dit « Look at » pour « Regarde »." },
  { "id": "kcon-a2-u02-06", "level": "A2", "unit": 2, "unitTitleFr": "Hier, aujourd'hui et comparaisons", "order": 6, "promptFr": "Le hibou se réveille la nuit", "answers": ["The owl wakes at night"], "tiles": ["morning", "sleeps"], "noteFr": "On dit « at night » pour la nuit." },
  { "id": "kcon-a2-u02-07", "level": "A2", "unit": 2, "unitTitleFr": "Hier, aujourd'hui et comparaisons", "order": 7, "promptFr": "Mon camarade m'a aidé hier", "answers": ["My classmate helped me yesterday"], "tiles": ["help", "tomorrow"], "noteFr": "« Helped » est le passé de « help »." },
  { "id": "kcon-a2-u02-08", "level": "A2", "unit": 2, "unitTitleFr": "Hier, aujourd'hui et comparaisons", "order": 8, "promptFr": "Nous visitons nos grands-parents dimanche", "answers": ["We visit our grandparents on Sunday"], "tiles": ["Monday", "parents"], "noteFr": "Utilise « on » devant un jour." }
]
