[
  { "id": "kcon-a0-u01-01", "level": "A0", "unit": 1, "unitTitleFr": "Premiers mots : animaux et couleurs", "order": 1, "promptFr": "Un chat rouge", "answers": ["A red cat"], "tiles": ["blue", "dog"], "noteFr": "En anglais, la couleur se place avant l'animal." },
  { "id": "kcon-a0-u01-02", "level": "A0", "unit": 1, "unitTitleFr": "Premiers mots : animaux et couleurs", "order": 2, "promptFr": "Un oiseau bleu", "answers": ["A blue bird"], "tiles": ["red", "cat"], "noteFr": "« Blue » vient juste avant « bird »." },
  { "id": "kcon-a0-u01-03", "level": "A0", "unit": 1, "unitTitleFr": "Premiers mots : animaux et couleurs", "order": 3, "promptFr": "Le soleil est jaune", "answers": ["The sun is yellow"], "tiles": ["blue", "cat"], "noteFr": "Utilise « is » pour décrire la couleur." },
  { "id": "kcon-a0-u01-04", "level": "A0", "unit": 1, "unitTitleFr": "Premiers mots : animaux et couleurs", "order": 4, "promptFr": "J'ai un chien", "answers": ["I have a dog"], "tiles": ["cat", "two"], "noteFr": "« I have » veut dire « j'ai »." },
  { "id": "kcon-a0-u01-05", "level": "A0", "unit": 1, "unitTitleFr": "Premiers mots : animaux et couleurs", "order": 5, "promptFr": "Je vois deux chats", "answers": ["I see two cats"], "tiles": ["one", "dog"], "noteFr": "N'oublie pas le -s à « cats » quand il y en a deux." },
  { "id": "kcon-a0-u01-06", "level": "A0", "unit": 1, "unitTitleFr": "Premiers mots : animaux et couleurs", "order": 6, "promptFr": "Ouvre ton livre", "answers": ["Open your book"], "tiles": ["red", "close"], "noteFr": "« Open » signifie « ouvre »." },
  { "id": "kcon-a0-u01-07", "level": "A0", "unit": 1, "unitTitleFr": "Premiers mots : animaux et couleurs", "order": 7, "promptFr": "Je mange une pomme", "answers": ["I eat an apple"], "tiles": ["book", "two"], "noteFr": "Devant une voyelle, « a » devient « an »." },
  { "id": "kcon-a0-u01-08", "level": "A0", "unit": 1, "unitTitleFr": "Premiers mots : animaux et couleurs", "order": 8, "promptFr": "Bonjour, je m'appelle Awa", "answers": ["Hello, my name is Awa", "Hello my name is Awa"], "tiles": ["goodbye", "book"], "noteFr": "« My name is... » sert à te présenter." },

  { "id": "kcon-a1-u01-01", "level": "A1", "unit": 1, "unitTitleFr": "Ce que j'aime à l'école et à la maison", "order": 1, "promptFr": "J'aime les bananes", "answers": ["I like bananas"], "tiles": ["don't", "apple"], "noteFr": "Utilise « I like » avec le mot au pluriel." },
  { "id": "kcon-a1-u01-02", "level": "A1", "unit": 1, "unitTitleFr": "Ce que j'aime à l'école et à la maison", "order": 2, "promptFr": "Je n'aime pas la pluie", "answers": ["I don't like rain", "I do not like rain"], "tiles": ["sun", "is"], "noteFr": "« Don't like » sert à dire que tu n'aimes pas." },
  { "id": "kcon-a1-u01-03", "level": "A1", "unit": 1, "unitTitleFr": "Ce que j'aime à l'école et à la maison", "order": 3, "promptFr": "Ma sœur joue au foot", "answers": ["My sister plays football"], "tiles": ["brother", "play"], "noteFr": "Avec « my sister », le verbe prend un -s." },
  { "id": "kcon-a1-u01-04", "level": "A1", "unit": 1, "unitTitleFr": "Ce que j'aime à l'école et à la maison", "order": 4, "promptFr": "Je dessine avec un crayon", "answers": ["I draw with a pencil"], "tiles": ["book", "sleep"], "noteFr": "« With » veut dire « avec »." },
  { "id": "kcon-a1-u01-05", "level": "A1", "unit": 1, "unitTitleFr": "Ce que j'aime à l'école et à la maison", "order": 5, "promptFr": "Mets tes chaussures", "answers": ["Put on your shoes"], "tiles": ["shirt", "open"], "noteFr": "« Put on » veut dire « enfile / mets »." },
  { "id": "kcon-a1-u01-06", "level": "A1", "unit": 1, "unitTitleFr": "Ce que j'aime à l'école et à la maison", "order": 6, "promptFr": "Je me réveille à sept heures", "answers": ["I wake up at seven"], "tiles": ["ten", "sleep"], "noteFr": "On utilise « at » devant l'heure." },

  { "id": "kcon-a2-u01-01", "level": "A2", "unit": 1, "unitTitleFr": "Mes routines et découvertes", "order": 1, "promptFr": "Je finis mes devoirs avant le dîner", "answers": ["I finish my homework before dinner"], "tiles": ["after", "book"], "noteFr": "« Before » signifie « avant »." },
  { "id": "kcon-a2-u01-02", "level": "A2", "unit": 1, "unitTitleFr": "Mes routines et découvertes", "order": 2, "promptFr": "Je me brosse les dents chaque soir", "answers": ["I brush my teeth every night"], "tiles": ["morning", "wash"], "noteFr": "« Every night » veut dire « chaque soir »." },
  { "id": "kcon-a2-u01-03", "level": "A2", "unit": 1, "unitTitleFr": "Mes routines et découvertes", "order": 3, "promptFr": "Regarde l'arc-en-ciel dans le ciel", "answers": ["Look at the rainbow in the sky"], "tiles": ["rain", "on"], "noteFr": "On dit « Look at » pour « Regarde »." },
  { "id": "kcon-a2-u01-04", "level": "A2", "unit": 1, "unitTitleFr": "Mes routines et découvertes", "order": 4, "promptFr": "Elle a un sac à dos violet", "answers": ["She has a purple backpack"], "tiles": ["have", "red"], "noteFr": "Avec « she », « have » devient « has »." },
  { "id": "kcon-a2-u01-05", "level": "A2", "unit": 1, "unitTitleFr": "Mes routines et découvertes", "order": 5, "promptFr": "Il y a vingt élèves en classe", "answers": ["There are twenty pupils in class"], "tiles": ["is", "ten"], "noteFr": "« There are » s'utilise pour plusieurs personnes." },
  { "id": "kcon-a2-u01-06", "level": "A2", "unit": 1, "unitTitleFr": "Mes routines et découvertes", "order": 6, "promptFr": "Ma grand-mère raconte des histoires drôles", "answers": ["My grandmother tells funny stories"], "tiles": ["say", "sad"], "noteFr": "« Tells » veut dire « raconte »." }
]
