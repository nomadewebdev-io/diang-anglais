[
  { "id": "ksent-a0-01", "level": "A0", "en": "Hello! My name is Awa.", "fr": "Bonjour ! Je m'appelle Awa." },
  { "id": "ksent-a0-02", "level": "A0", "en": "The cat sleeps.", "fr": "Le chat dort." },
  { "id": "ksent-a0-03", "level": "A0", "en": "My dog runs fast.", "fr": "Mon chien court vite." },
  { "id": "ksent-a0-04", "level": "A0", "en": "A blue bird sings.", "fr": "Un oiseau bleu chante." },
  { "id": "ksent-a0-05", "level": "A0", "en": "I have a red ball.", "fr": "J'ai un ballon rouge." },
  { "id": "ksent-a0-06", "level": "A0", "en": "The sky is blue.", "fr": "Le ciel est bleu." },
  { "id": "ksent-a0-07", "level": "A0", "en": "The sun is yellow.", "fr": "Le soleil est jaune." },
  { "id": "ksent-a0-08", "level": "A0", "en": "Open your book now.", "fr": "Ouvre ton livre maintenant." },
  { "id": "ksent-a0-09", "level": "A0", "en": "I see one bird.", "fr": "Je vois un oiseau." },
  { "id": "ksent-a0-10", "level": "A0", "en": "I have two hands.", "fr": "J'ai deux mains." },
  { "id": "ksent-a0-11", "level": "A0", "en": "Three cats sleep here.", "fr": "Trois chats dorment ici." },
  { "id": "ksent-a0-12", "level": "A0", "en": "My mother smiles warmly.", "fr": "Ma maman sourit chaleureusement." },
  { "id": "ksent-a0-13", "level": "A0", "en": "My father reads books.", "fr": "Mon papa lit des livres." },
  { "id": "ksent-a0-14", "level": "A0", "en": "Wash your hands first.", "fr": "Lave tes mains d'abord." },
  { "id": "ksent-a0-15", "level": "A0", "en": "I eat an apple.", "fr": "Je mange une pomme." },
  { "id": "ksent-a0-16", "level": "A0", "en": "This mango is sweet.", "fr": "Cette mangue est sucrée." },
  { "id": "ksent-a0-17", "level": "A0", "en": "Drink cold water please.", "fr": "Bois de l'eau fraîche s'il te plaît." },
  { "id": "ksent-a0-18", "level": "A0", "en": "I drink warm milk.", "fr": "Je bois du lait chaud." },
  { "id": "ksent-a0-19", "level": "A0", "en": "We cook white rice.", "fr": "Nous cuisinons du riz blanc." },
  { "id": "ksent-a0-20", "level": "A0", "en": "Wear your sun hat.", "fr": "Mets ton chapeau de soleil." },
  { "id": "ksent-a0-21", "level": "A0", "en": "My pants are blue.", "fr": "Mon pantalon est bleu." },
  { "id": "ksent-a0-22", "level": "A0", "en": "She wears a pink dress.", "fr": "Elle porte une robe rose." },
  { "id": "ksent-a0-23", "level": "A0", "en": "Tie your white shoes.", "fr": "Attache tes chaussures blanches." },
  { "id": "ksent-a0-24", "level": "A0", "en": "The moon is round.", "fr": "La lune est ronde." },
  { "id": "ksent-a0-25", "level": "A0", "en": "See the bright star.", "fr": "Vois l'étoile brillante." },
  { "id": "ksent-a0-26", "level": "A0", "en": "Sit under the tree.", "fr": "Assieds-toi sous l'arbre." },
  { "id": "ksent-a0-27", "level": "A0", "en": "Our house is clean.", "fr": "Notre maison est propre." },
  { "id": "ksent-a0-28", "level": "A0", "en": "Close the front door.", "fr": "Ferme la porte d'entrée." },
  { "id": "ksent-a0-29", "level": "A0", "en": "Make your bed now.", "fr": "Fais ton lit maintenant." },
  { "id": "ksent-a0-30", "level": "A0", "en": "Turn on the lamp.", "fr": "Allume la lampe." },
  { "id": "ksent-a0-31", "level": "A0", "en": "Thank you very much!", "fr": "Merci beaucoup !" },
  { "id": "ksent-a0-32", "level": "A0", "en": "Yes, I am ready.", "fr": "Oui, je suis prêt." },
  { "id": "ksent-a0-33", "level": "A0", "en": "I sleep at nine.", "fr": "Je dors à neuf heures." },
  { "id": "ksent-a0-34", "level": "A0", "en": "Let us play outside!", "fr": "Jouons dehors !" },
  { "id": "ksent-a0-35", "level": "A0", "en": "Run to the tree!", "fr": "Cours jusqu'à l'arbre !" },
  { "id": "ksent-a0-36", "level": "A0", "en": "I read every evening.", "fr": "Je lis chaque soir." },
  { "id": "ksent-a0-37", "level": "A0", "en": "Write your name clearly.", "fr": "Écris ton prénom clairement." },
  { "id": "ksent-a0-38", "level": "A0", "en": "We sing happy songs.", "fr": "Nous chantons des chansons joyeuses." },
  { "id": "ksent-a0-39", "level": "A0", "en": "The green frog hops.", "fr": "La grenouille verte saute." },
  { "id": "ksent-a0-40", "level": "A0", "en": "The cow eats grass.", "fr": "La vache mange de l'herbe." },

  { "id": "ksent-a1-01", "level": "A1", "en": "The elephant is very big.", "fr": "L'éléphant est très grand." },
  { "id": "ksent-a1-02", "level": "A1", "en": "The monkey climbs tall trees.", "fr": "Le singe grimpe aux grands arbres." },
  { "id": "ksent-a1-03", "level": "A1", "en": "The zebra has black stripes.", "fr": "Le zèbre a des rayures noires." },
  { "id": "ksent-a1-04", "level": "A1", "en": "The turtle walks very slowly.", "fr": "La tortue marche très lentement." },
  { "id": "ksent-a1-05", "level": "A1", "en": "Her drawing is very colorful.", "fr": "Son dessin est très coloré." },
  { "id": "ksent-a1-06", "level": "A1", "en": "I have striped blue socks.", "fr": "J'ai des chaussettes bleues rayées." },
  { "id": "ksent-a1-07", "level": "A1", "en": "Twelve months make one year.", "fr": "Douze mois font une année." },
  { "id": "ksent-a1-08", "level": "A1", "en": "Twenty pupils sit in class.", "fr": "Vingt élèves sont assis en classe." },
  { "id": "ksent-a1-09", "level": "A1", "en": "Grandma bakes sweet bread today.", "fr": "Mamie prépare du pain sucré aujourd'hui." },
  { "id": "ksent-a1-10", "level": "A1", "en": "My cousin lives near school.", "fr": "Mon cousin habite près de l'école." },
  { "id": "ksent-a1-11", "level": "A1", "en": "My parents help me daily.", "fr": "Mes parents m'aident chaque jour." },
  { "id": "ksent-a1-12", "level": "A1", "en": "Happy birthday to my friend!", "fr": "Joyeux anniversaire à mon ami !" },
  { "id": "ksent-a1-13", "level": "A1", "en": "Brush your clean white teeth.", "fr": "Brosse tes dents blanches et propres." },
  { "id": "ksent-a1-14", "level": "A1", "en": "Giraffes have very long necks.", "fr": "Les girafes ont de très longs cous." },
  { "id": "ksent-a1-15", "level": "A1", "en": "Give a big friendly smile.", "fr": "Fais un grand sourire amical." },
  { "id": "ksent-a1-16", "level": "A1", "en": "Our teacher explains the lesson.", "fr": "Notre maîtresse explique la leçon." },
  { "id": "ksent-a1-17", "level": "A1", "en": "Write neatly in your notebook.", "fr": "Écris proprement dans ton cahier." },
  { "id": "ksent-a1-18", "level": "A1", "en": "We play games during recess.", "fr": "Nous jouons pendant la récréation." },
  { "id": "ksent-a1-19", "level": "A1", "en": "Crunchy orange carrots taste good.", "fr": "Les carottes croquantes sont bonnes." },
  { "id": "ksent-a1-20", "level": "A1", "en": "Spread sweet butter on bread.", "fr": "Étale du beurre sur le pain." },
  { "id": "ksent-a1-21", "level": "A1", "en": "Eat hot vegetable soup now.", "fr": "Mange de la soupe chaude maintenant." },
  { "id": "ksent-a1-22", "level": "A1", "en": "Zip up your warm jacket.", "fr": "Ferme ta veste chaude." },
  { "id": "ksent-a1-23", "level": "A1", "en": "Wear yellow shorts in summer.", "fr": "Mets un short jaune en été." },
  { "id": "ksent-a1-24", "level": "A1", "en": "Wrap a cozy red scarf.", "fr": "Enroule une écharpe rouge douillette." },
  { "id": "ksent-a1-25", "level": "A1", "en": "Today is warm and sunny.", "fr": "Aujourd'hui il fait chaud et beau." },
  { "id": "ksent-a1-26", "level": "A1", "en": "Stay inside on rainy days.", "fr": "Reste dedans les jours de pluie." },
  { "id": "ksent-a1-27", "level": "A1", "en": "Water the pink garden flower.", "fr": "Arrose la fleur rose du jardin." },
  { "id": "ksent-a1-28", "level": "A1", "en": "My bedroom is neat and quiet.", "fr": "Ma chambre est rangée et calme." },
  { "id": "ksent-a1-29", "level": "A1", "en": "Mom cooks in the kitchen.", "fr": "Maman cuisine dans la cuisine." },
  { "id": "ksent-a1-30", "level": "A1", "en": "Sit on the soft sofa.", "fr": "Assieds-toi sur le canapé doux." },
  { "id": "ksent-a1-31", "level": "A1", "en": "I wake up at seven.", "fr": "Je me réveille à sept heures." },
  { "id": "ksent-a1-32", "level": "A1", "en": "Wash your hands with soap.", "fr": "Lave-toi les mains au savon." },
  { "id": "ksent-a1-33", "level": "A1", "en": "Lunch is ready at noon.", "fr": "Le déjeuner est prêt à midi." },
  { "id": "ksent-a1-34", "level": "A1", "en": "Listen carefully to the story.", "fr": "Écoute attentivement l'histoire." },
  { "id": "ksent-a1-35", "level": "A1", "en": "Draw a happy little cat.", "fr": "Dessine un petit chat joyeux." },
  { "id": "ksent-a1-36", "level": "A1", "en": "Count all the bright stars.", "fr": "Compte toutes les étoiles brillantes." },
  { "id": "ksent-a1-37", "level": "A1", "en": "Ducks swim in the pond.", "fr": "Les canards nagent dans l'étang." },
  { "id": "ksent-a1-38", "level": "A1", "en": "Share your snacks with friends.", "fr": "Partage ton goûter avec tes amis." },
  { "id": "ksent-a1-39", "level": "A1", "en": "Good morning, my dear friend!", "fr": "Bonjour, mon cher ami !" },
  { "id": "ksent-a1-40", "level": "A1", "en": "We dance to happy music.", "fr": "Nous dansons sur une musique joyeuse." },

  { "id": "ksent-a2-01", "level": "A2", "en": "A butterfly lands on flowers.", "fr": "Un papillon se pose sur les fleurs." },
  { "id": "ksent-a2-02", "level": "A2", "en": "Whales swim in deep oceans.", "fr": "Les baleines nagent dans les océans." },
  { "id": "ksent-a2-03", "level": "A2", "en": "Penguins love very icy water.", "fr": "Les manchots aiment l'eau glacée." },
  { "id": "ksent-a2-04", "level": "A2", "en": "The green parrot can talk.", "fr": "Le perroquet vert sait parler." },
  { "id": "ksent-a2-05", "level": "A2", "en": "The owl wakes at night.", "fr": "Le hibou se réveille la nuit." },
  { "id": "ksent-a2-06", "level": "A2", "en": "The squirrel collects brown nuts.", "fr": "L'écureuil ramasse des noisettes brunes." },
  { "id": "ksent-a2-07", "level": "A2", "en": "Flamingos stand on one leg.", "fr": "Les flamants tiennent sur une patte." },
  { "id": "ksent-a2-08", "level": "A2", "en": "Look at the bright rainbow!", "fr": "Regarde l'arc-en-ciel brillant !" },
  { "id": "ksent-a2-09", "level": "A2", "en": "April has thirty sunny days.", "fr": "Avril compte trente jours ensoleillés." },
  { "id": "ksent-a2-10", "level": "A2", "en": "First, wash both your hands.", "fr": "D'abord, lave tes deux mains." },
  { "id": "ksent-a2-11", "level": "A2", "en": "We visit our grandparents on Sunday.", "fr": "Nous visitons nos grands-parents dimanche." },
  { "id": "ksent-a2-12", "level": "A2", "en": "My classmate helped me yesterday.", "fr": "Mon camarade m'a aidé hier." },
  { "id": "ksent-a2-13", "level": "A2", "en": "Our school team won today.", "fr": "Notre équipe a gagné aujourd'hui." },
  { "id": "ksent-a2-14", "level": "A2", "en": "Carry your bag on both shoulders.", "fr": "Porte ton sac sur les deux épaules." },
  { "id": "ksent-a2-15", "level": "A2", "en": "Fresh fruit keeps us healthy.", "fr": "Les fruits frais gardent en bonne santé." },
  { "id": "ksent-a2-16", "level": "A2", "en": "I finish homework before dinner.", "fr": "Je finis mes devoirs avant le dîner." },
  { "id": "ksent-a2-17", "level": "A2", "en": "Check new words in dictionary.", "fr": "Vérifie les nouveaux mots au dictionnaire." },
  { "id": "ksent-a2-18", "level": "A2", "en": "We borrow books from library.", "fr": "Nous empruntons des livres à la bibliothèque." },
  { "id": "ksent-a2-19", "level": "A2", "en": "She has a purple backpack.", "fr": "Elle a un sac à dos violet." },
  { "id": "ksent-a2-20", "level": "A2", "en": "We love fun science experiments.", "fr": "Nous adorons les expériences de sciences." },
  { "id": "ksent-a2-21", "level": "A2", "en": "Write a short funny story.", "fr": "Écris une courte histoire drôle." },
  { "id": "ksent-a2-22", "level": "A2", "en": "Cold watermelon tastes great today.", "fr": "La pastèque fraîche est délicieuse aujourd'hui." },
  { "id": "ksent-a2-23", "level": "A2", "en": "Wash green grapes before eating.", "fr": "Lave les raisins verts avant de manger." },
  { "id": "ksent-a2-24", "level": "A2", "en": "Eat yogurt with sweet fruit.", "fr": "Mange du yaourt avec des fruits." },
  { "id": "ksent-a2-25", "level": "A2", "en": "Warm pancakes taste very sweet.", "fr": "Les crêpes chaudes sont très sucrées." },
  { "id": "ksent-a2-26", "level": "A2", "en": "Pack a healthy fruit snack.", "fr": "Emporte un goûter aux fruits sain." },
  { "id": "ksent-a2-27", "level": "A2", "en": "Wear your raincoat in rain.", "fr": "Mets ton imperméable sous la pluie." },
  { "id": "ksent-a2-28", "level": "A2", "en": "Run outside in clean sneakers.", "fr": "Cours dehors avec des baskets propres." },
  { "id": "ksent-a2-29", "level": "A2", "en": "Open your big blue umbrella.", "fr": "Ouvre ton grand parapluie bleu." },
  { "id": "ksent-a2-30", "level": "A2", "en": "A cool breeze blows softly.", "fr": "Une brise fraîche souffle doucement." },
  { "id": "ksent-a2-31", "level": "A2", "en": "Jump over the little puddle!", "fr": "Saute par-dessus la petite flaque !" },
  { "id": "ksent-a2-32", "level": "A2", "en": "Rest in the tree shade.", "fr": "Repose-toi à l'ombre de l'arbre." },
  { "id": "ksent-a2-33", "level": "A2", "en": "Watch the golden morning sunrise.", "fr": "Regarde le lever du soleil doré." },
  { "id": "ksent-a2-34", "level": "A2", "en": "Walk slowly up the stairs.", "fr": "Monte doucement les escaliers." },
  { "id": "ksent-a2-35", "level": "A2", "en": "Fold your warm soft blanket.", "fr": "Plie ta couverture douce et chaude." },
  { "id": "ksent-a2-36", "level": "A2", "en": "Sort your books on bookshelf.", "fr": "Range tes livres sur l'étagère." },
  { "id": "ksent-a2-37", "level": "A2", "en": "I brush my teeth nightly.", "fr": "Je me brosse les dents chaque soir." },
  { "id": "ksent-a2-38", "level": "A2", "en": "We ride our bikes safely.", "fr": "Nous faisons du vélo prudemment." },
  { "id": "ksent-a2-39", "level": "A2", "en": "Tidy up all your toys.", "fr": "Range tous tes jouets." },
  { "id": "ksent-a2-40", "level": "A2", "en": "See you tomorrow morning, friend!", "fr": "À demain matin, mon ami !" }
]
