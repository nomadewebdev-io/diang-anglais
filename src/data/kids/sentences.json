[
  { "id": "ksent-a0-01", "level": "A0", "en": "Hello! My name is Awa.", "fr": "Bonjour ! Je m'appelle Awa." },
  { "id": "ksent-a0-02", "level": "A0", "en": "The cat is small.", "fr": "Le chat est petit." },
  { "id": "ksent-a0-03", "level": "A0", "en": "I have a red ball.", "fr": "J'ai un ballon rouge." },
  { "id": "ksent-a0-04", "level": "A0", "en": "The sky is blue.", "fr": "Le ciel est bleu." },
  { "id": "ksent-a0-05", "level": "A0", "en": "Two dogs run fast.", "fr": "Deux chiens courent vite." },
  { "id": "ksent-a0-06", "level": "A0", "en": "Open your book.", "fr": "Ouvre ton livre." },
  { "id": "ksent-a0-07", "level": "A0", "en": "I see one bird.", "fr": "Je vois un oiseau." },
  { "id": "ksent-a0-08", "level": "A0", "en": "The sun is yellow.", "fr": "Le soleil est jaune." },
  { "id": "ksent-a0-09", "level": "A0", "en": "Wash your hands.", "fr": "Lave-toi les mains." },
  { "id": "ksent-a0-10", "level": "A0", "en": "I eat an apple.", "fr": "Je mange une pomme." },

  { "id": "ksent-a1-01", "level": "A1", "en": "The elephant is very big.", "fr": "L'éléphant est très grand." },
  { "id": "ksent-a1-02", "level": "A1", "en": "I like sweet bananas.", "fr": "J'aime les bananes sucrées." },
  { "id": "ksent-a1-03", "level": "A1", "en": "My sister plays football.", "fr": "Ma sœur joue au football." },
  { "id": "ksent-a1-04", "level": "A1", "en": "I draw with a pencil.", "fr": "Je dessine avec un crayon." },
  { "id": "ksent-a1-05", "level": "A1", "en": "Close your eyes and listen.", "fr": "Ferme les yeux et écoute." },
  { "id": "ksent-a1-06", "level": "A1", "en": "We eat bread in the morning.", "fr": "Nous mangeons du pain le matin." },
  { "id": "ksent-a1-07", "level": "A1", "en": "Put on your blue shoes.", "fr": "Mets tes chaussures bleues." },
  { "id": "ksent-a1-08", "level": "A1", "en": "I wake up at seven.", "fr": "Je me réveille à sept heures." },
  { "id": "ksent-a1-09", "level": "A1", "en": "My bedroom is very quiet.", "fr": "Ma chambre est très calme." },
  { "id": "ksent-a1-10", "level": "A1", "en": "Count from one to ten.", "fr": "Compte de un à dix." },

  { "id": "ksent-a2-01", "level": "A2", "en": "I finish my homework before dinner.", "fr": "Je finis mes devoirs avant le dîner." },
  { "id": "ksent-a2-02", "level": "A2", "en": "A butterfly lands on the flower.", "fr": "Un papillon se pose sur la fleur." },
  { "id": "ksent-a2-03", "level": "A2", "en": "She has a purple backpack.", "fr": "Elle a un sac à dos violet." },
  { "id": "ksent-a2-04", "level": "A2", "en": "There are twenty pupils in class.", "fr": "Il y a vingt élèves en classe." },
  { "id": "ksent-a2-05", "level": "A2", "en": "My grandmother tells funny stories.", "fr": "Ma grand-mère raconte des histoires drôles." },
  { "id": "ksent-a2-06", "level": "A2", "en": "Carry your bag on both shoulders.", "fr": "Porte ton sac sur les deux épaules." },
  { "id": "ksent-a2-07", "level": "A2", "en": "Cold watermelon tastes great.", "fr": "La pastèque fraîche est délicieuse." },
  { "id": "ksent-a2-08", "level": "A2", "en": "Wear your raincoat in the rain.", "fr": "Mets ton imperméable sous la pluie." },
  { "id": "ksent-a2-09", "level": "A2", "en": "Look at the rainbow in the sky!", "fr": "Regarde l'arc-en-ciel dans le ciel !" },
  { "id": "ksent-a2-10", "level": "A2", "en": "I brush my teeth every night.", "fr": "Je me brosse les dents chaque soir." }
