[{"id":"klesson-a0-01","level":"A0","title":"Dire bonjour et te présenter","explanationFr":"Utilise « Hello! » pour dire bonjour et « My name is... » pour donner ton prénom.","examples":[{"en":"Hello! My name is Awa.","fr":"Bonjour ! Je m'appelle Awa."},{"en":"Nice to meet you!","fr":"Ravi de te rencontrer !"}],"exercises":[{"prompt":"Comment dis-tu « Bonjour ! » en anglais ?","options":["Hello!","Goodbye!","Thank you!"],"answerIndex":0},{"prompt":"Complète : « My ___ is Omar. »","options":["book","name","cat"],"answerIndex":1},{"prompt":"Que réponds-tu à « Nice to meet you! » ?","options":["Nice to meet you too!","Good night!","One, two!"],"answerIndex":0},{"prompt":"Quel mot veut dire « Au revoir » ?","options":["Please","Goodbye","Hello"],"answerIndex":1}]},{"id":"klesson-a0-02","level":"A0","title":"Les couleurs avant le nom","explanationFr":"En anglais, tu places toujours la couleur juste avant l'objet ou l'animal.","examples":[{"en":"I have a red ball.","fr":"J'ai un ballon rouge."},{"en":"Look at the blue bird.","fr":"Regarde l'oiseau bleu."}],"exercises":[{"prompt":"Comment dis-tu « un chat noir » ?","options":["a cat black","a black cat","black a cat"],"answerIndex":1},{"prompt":"Comment dis-tu « un soleil jaune » ?","options":["a yellow sun","a sun yellow","yellow a sun"],"answerIndex":0},{"prompt":"Complète : « She wears a ___ dress. »","options":["pink","cat","one"],"answerIndex":0},{"prompt":"Choisis la phrase correcte :","options":["I see a green frog.","I see a frog green.","I see green a frog."],"answerIndex":0}]},{"id":"klesson-a0-03","level":"A0","title":"Un ou plusieurs : le -s du pluriel","explanationFr":"Pour parler de deux choses ou plus, ajoute simplement un -s à la fin du mot.","examples":[{"en":"one cat -> two cats","fr":"un chat -> deux chats"},{"en":"one book -> three books","fr":"un livre -> trois livres"}],"exercises":[{"prompt":"Comment écris-tu « deux chiens » ?","options":["two dog","two dogs","two doges"],"answerIndex":1},{"prompt":"Complète : « I have three ___. »","options":["apple","apples","an apple"],"answerIndex":1},{"prompt":"Quel mot est au singulier ?","options":["birds","books","cat"],"answerIndex":2},{"prompt":"Choisis la phrase correcte :","options":["Two cats sleep.","Two cat sleep.","One cats sleep."],"answerIndex":0}]},{"id":"klesson-a0-04","level":"A0","title":"Utiliser I am et You are","explanationFr":"Utilise « I am » pour parler de toi, et « You are » pour parler à ton ami.","examples":[{"en":"I am eight years old.","fr":"J'ai huit ans."},{"en":"You are my good friend.","fr":"Tu es mon bon ami."}],"exercises":[{"prompt":"Complète : « I ___ ready! »","options":["am","is","are"],"answerIndex":0},{"prompt":"Complète : « You ___ very kind. »","options":["am","are","is"],"answerIndex":1},{"prompt":"Comment dis-tu « J'ai neuf ans » ?","options":["I am nine years old.","I are nine.","I is nine."],"answerIndex":0},{"prompt":"Choisis la bonne phrase :","options":["You am happy.","You are happy.","I are happy."],"answerIndex":1}]},{"id":"klesson-a0-05","level":"A0","title":"Dire a ou an devant un mot","explanationFr":"Utilise « a » devant une consonne, et « an » devant une voyelle (a, e, i, o, u).","examples":[{"en":"I see a red book.","fr":"Je vois un livre rouge."},{"en":"I eat an apple.","fr":"Je mange une pomme."}],"exercises":[{"prompt":"Complète : « I want ___ apple. »","options":["a","an","two"],"answerIndex":1},{"prompt":"Complète : « He has ___ blue pen. »","options":["an","a","three"],"answerIndex":1},{"prompt":"Complète : « Boil ___ egg, please. »","options":["a","an","four"],"answerIndex":1},{"prompt":"Choisis la phrase correcte :","options":["She sees an dog.","She sees a dog.","She sees an cat."],"answerIndex":1}]},{"id":"klesson-a0-06","level":"A0","title":"Être poli : please et thank you","explanationFr":"Ajoute « please » pour demander gentiment et dis « thank you » quand on t'aide.","examples":[{"en":"Pass the water, please.","fr":"Passe l'eau, s'il te plaît."},{"en":"Thank you very much!","fr":"Merci beaucoup !"}],"exercises":[{"prompt":"Que dis-tu pour demander gentiment ?","options":["Please","Goodbye","No"],"answerIndex":0},{"prompt":"Que dis-tu quand on te donne un cadeau ?","options":["Thank you!","Open!","Sleep!"],"answerIndex":0},{"prompt":"Complète : « Open the book, ___. »","options":["please","apple","red"],"answerIndex":0},{"prompt":"Que veut dire « You're welcome » ?","options":["Au revoir","De rien","Bonjour"],"answerIndex":1}]}]